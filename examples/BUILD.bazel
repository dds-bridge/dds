load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_test")
load("//:CPPVARIABLES.bzl", "DDS_CPPOPTS", "DDS_LINKOPTS", "DDS_LOCAL_DEFINES")
load("//:wasm_compat.bzl", "WASM_LINKOPTS")

# Examples use legacy C-style code, so we need to suppress certain warnings
EXAMPLES_CPPOPTS = DDS_CPPOPTS + select({
    "//:build_windows": [],
    "//:build_wasm": [],  # em++ has different warning flags
    "//:debug_build_windows": [],
    "//conditions:default": [
        "-Wno-deprecated-declarations",
        "-Wno-unused-variable",
    ],
})

EXAMPLES_LOCAL_DEFINES = DDS_LOCAL_DEFINES + select({
    "//:build_windows": ["_CRT_SECURE_NO_WARNINGS"],
    "//:debug_build_windows": ["_CRT_SECURE_NO_WARNINGS"],
    "//conditions:default": [],
})

# Emscripten link flags for examples built as WASM (see //wasm).
EXAMPLES_LINKOPTS_WASM = select({
    "//:build_wasm": WASM_LINKOPTS,
    "//conditions:default": [],
})

# Shared utilities used by all examples
cc_library(
    name = "hands",
    srcs = ["hands.cpp"],
    hdrs = ["hands.hpp"],
    includes = ["."],
    copts = EXAMPLES_CPPOPTS,
    local_defines = EXAMPLES_LOCAL_DEFINES,
    visibility = [
        "//examples:__subpackages__",
        "//wasm:__pkg__",
    ],
    deps = [
        "//library/src:dds",
        "//library/src/api:api_definitions",
    ],
)

