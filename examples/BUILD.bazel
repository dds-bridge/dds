load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library")
load("//:CPPVARIABLES.bzl", "DDS_CPPOPTS", "DDS_LINKOPTS", "DDS_LOCAL_DEFINES")

# Examples use legacy C-style code, so we need to suppress certain warnings
EXAMPLES_CPPOPTS = DDS_CPPOPTS + [
    "-Wno-deprecated-declarations",
    "-Wno-unused-variable",
]

# Shared utilities used by all examples
cc_library(
    name = "hands",
    srcs = ["hands.cpp"],
    hdrs = ["hands.hpp"],
    copts = EXAMPLES_CPPOPTS,
    local_defines = DDS_LOCAL_DEFINES,
    deps = [
        "//library/src:dds",
        "//library/src/api:api_definitions",
    ],
)

# Example binaries
cc_binary(
    name = "AnalyseAllPlaysBin",
    srcs = ["AnalyseAllPlaysBin.cpp"],
